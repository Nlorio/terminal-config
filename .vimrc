" Pathogen setup                                                                                                                                                                                           
execute pathogen#infect()                                                                                                                                                                                  
                                                                                                                                                                                                           
" Basic                                                                                                                                                                                                    
syntax on                                                                                                                                                                                                  
filetype plugin indent on                                                                                                                                                                                  
                                                                                                                                                                                                           
" escape timeout                                                                                                                                                                                           
set ttimeout                                                                                                                                                                                               
set ttimeoutlen=100                                                                                                                                                                                        
set timeoutlen=5                                                                                                                                                                                           
"set timeoutlen=1000                                                                                                                                                                                       
"set ttimeoutlen=5                                                                                                                                                                                         
                                                                                                                                                                                                           
                                                                                                                                                                                                           
" color-scheme                                                                                                                                                                                             
" colorscheme gruvbox                                                                                                                                                                                        
" let g:gruvbox_transparent_bg = '1'                                                                                                                                                                         
                                                                                                                                                                                                           
" tab                                                                                                                                                                                                      
filetype plugin indent on                                                                                                                                                                                  
" show existing tab with 4 spaces width                                                                                                                                                                    
set tabstop=4                                                                                                                                                                                              
" when indenting with '>', use 4 spaces width                                                                                                                                                              
set shiftwidth=4                                                                                                                                                                                           
" On pressing tab, insert 4 spaces                                                                                                                                                                         
set expandtab                                                                                                                                                                                              
                                                                                                                                                                                                           
                                                                                                                                                                                                           
" Lightline                                                                                                                                                                                                
set noshowmode                                                                                                                                                                                             
let g:lightline = { 'colorscheme': 'wombat', }                                                                                                                                                             
                                                
