# Ghostty Configuration

# Font
font-family = JetBrainsMono Nerd Font
font-size = 14

# Window
window-padding-x = 10
window-padding-y = 10
window-decoration = true

# Theme (Everforest Dark)
background = #2d353b
foreground = #d3c6aa

# Normal colors
palette = 0=#4b565c
palette = 1=#e67e80
palette = 2=#a7c080
palette = 3=#dbbc7f
palette = 4=#7fbbb3
palette = 5=#d699b6
palette = 6=#83c092
palette = 7=#d3c6aa

# Bright colors
palette = 8=#4b565c
palette = 9=#e67e80
palette = 10=#a7c080
palette = 11=#dbbc7f
palette = 12=#7fbbb3
palette = 13=#d699b6
palette = 14=#83c092
palette = 15=#d3c6aa

# Cursor
cursor-style = block
cursor-style-blink = false

# Shell integration
shell-integration = zsh

# Misc
copy-on-select = true
