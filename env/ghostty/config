# Ghostty Configuration

# Font
font-family = JetBrainsMono Nerd Font
font-size = 14

# Window
window-padding-x = 10
window-padding-y = 10
window-decoration = true

# Theme
theme = tiki-love-dark

# Cursor
cursor-style = block
cursor-style-blink = false

# Shell integration
shell-integration = zsh

# Misc
copy-on-select = true
