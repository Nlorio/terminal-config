# Ghostty Configuration

# Font
font-family = JetBrainsMono Nerd Font
font-size = 14

# Window
window-padding-x = 10
window-padding-y = 10
window-decoration = true

# Theme (follows macOS system appearance by default)
theme = light:Gruvbox Light,dark:Everforest Dark Medium

# Local theme override (written by dark-term/light-term commands)
config-file = ?~/.config/ghostty/theme-override

# Cursor
cursor-style = block
cursor-style-blink = false

# Shell integration
shell-integration = zsh

# Misc
copy-on-select = true
