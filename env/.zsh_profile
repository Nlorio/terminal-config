# Directory holding per-role markdown context files for long-running worktree
# agents (implementor.md / researcher.md / adversarial.md). Override
# `_GW_ROLES_DIR` to point elsewhere if you keep your roles outside the repo.
_GW_ROLES_DIR="${_GW_ROLES_DIR:-$HOME/Documents/config/terminal-config/env/worktree-roles}"

# Persistent worktree TODO file location for a given branch. Single source of
# truth for the path convention used by `_gw_create_worktree_todo` and
# `_gw_create_ai_windows`.
_gw_todo_path() {
  echo "$HOME/Documents/plans/worktree-todos/$1/TODO.md"
}

# Send the chosen AI command to a tmux target, optionally seeding the agent
# with a role file as system-level context (claude) or as the first user
# message (codex, which has no system-prompt flag).
#   $1 target  $2 ai_choice (c|x)  $3 role_file (optional)  $4 todo_file (optional)
_gw_run_ai() {
  local target="$1" ai="$2" role_file="${3:-}" todo_file="${4:-}"
  local cmd
  if [[ "$ai" =~ ^[Xx]$ ]]; then
    cmd="codex --dangerously-bypass-approvals-and-sandbox"
    if [ -n "$role_file" ]; then
      cmd="$cmd \"\$(printf 'Your role for this session (worktree TODO: %s):\\n\\n' '${todo_file:-none}')\$(cat $role_file)\""
    fi
  else
    cmd="claude --dangerously-skip-permissions"
    if [ -n "$role_file" ]; then
      cmd="$cmd --append-system-prompt \"\$(cat $role_file)\$(printf '\\n\\nWorktree TODO file: %s' '${todo_file:-none}')\""
    fi
  fi
  tmux send-keys -t "$target" "$cmd" C-m
}

# Build the AI windows for a session based on layout choice.
#   $1 session  $2 worktree_path  $3 ai_choice (c|x)  $4 layout (d|l)
_gw_create_ai_windows() {
  local session="$1" wt="$2" ai="$3" layout="$4"

  if [[ "$layout" =~ ^[Ll]$ ]]; then
    local todo
    todo=$(_gw_todo_path "$session")

    # Window 2 — agents (vertical split: implementor | researcher).
    # Labels go in the @role per-pane user option (durable — claude's OSC
    # title escapes can't overwrite it) and the border format renders only
    # that, so the displayed label is never branch-prefixed.
    tmux new-window -t "$session:2" -c "$wt" -n "agents"
    tmux set-window-option -t "$session:2" pane-border-status top
    tmux set-window-option -t "$session:2" pane-border-format " #{@role} "
    tmux split-window -t "$session:2" -h -c "$wt"
    tmux set-option -p -t "$session:2.0" @role "implementor"
    tmux set-option -p -t "$session:2.1" @role "researcher"
    _gw_run_ai "$session:2.0" "$ai" "$_GW_ROLES_DIR/implementor.md" "$todo"
    _gw_run_ai "$session:2.1" "$ai" "$_GW_ROLES_DIR/researcher.md" "$todo"

    # Window 3 — adversarial reviewer
    tmux new-window -t "$session:3" -c "$wt" -n "review"
    tmux set-window-option -t "$session:3" pane-border-status top
    tmux set-window-option -t "$session:3" pane-border-format " #{@role} "
    tmux set-option -p -t "$session:3.0" @role "adversarial"
    _gw_run_ai "$session:3.0" "$ai" "$_GW_ROLES_DIR/adversarial.md" "$todo"
  else
    # Default — single AI window, no role priming
    tmux new-window -t "$session:2" -c "$wt" -n "ai"
    _gw_run_ai "$session:2" "$ai"
  fi
}

# Create a persistent TODO file for a long-running worktree. No-op for the
# default layout. Idempotent: never overwrites existing content. The real file
# lives outside the worktree so `gwr` cannot delete it; a symlink inside the
# worktree provides easy access and is ignored via the per-worktree exclude.
#   $1 branch  $2 worktree_path  $3 layout (d|l)
_gw_create_worktree_todo() {
  local branch="$1" wt="$2" layout="$3"
  [[ "$layout" =~ ^[Ll]$ ]] || return 0

  local todo_file
  todo_file=$(_gw_todo_path "$branch")
  local todo_dir="${todo_file%/*}"
  local link="$wt/WORKTREE-TODO.md"

  mkdir -p "$todo_dir"

  if [ ! -f "$todo_file" ]; then
    cat > "$todo_file" <<EOF
# $branch — Worktree TODO

- Created: $(date '+%Y-%m-%d')
- Branch: \`$branch\`
- Worktree: \`$wt\`

## Notes

## Tasks

- [ ]
EOF
    echo "  📝 Created persistent TODO: $todo_file"
  else
    echo "  📝 Re-attached existing TODO: $todo_file"
  fi

  ln -sfn "$todo_file" "$link"

  local exclude
  exclude=$(git -C "$wt" rev-parse --git-path info/exclude 2>/dev/null)
  if [ -n "$exclude" ] && [ -f "$exclude" ] && ! grep -qxF "WORKTREE-TODO.md" "$exclude"; then
    echo "WORKTREE-TODO.md" >> "$exclude"
  fi
}

# Detect whether a boxy with the given name already exists. Parses
# `notion boxy ls` table output: skips header until the dashed separator,
# then matches column 1 (the (current) marker, when present, is column 2).
_gw_boxy_exists() {
  local name="$1"
  notion boxy ls 2>/dev/null | awk '
    /^---/ { in_data = 1; next }
    in_data && NF > 0 { print $1 }
  ' | grep -qxF "$name"
}

# Create a fresh branch named after the boxy, checked out from origin/main.
# Only invoked on the fresh-create path of gwb — existing boxies keep
# whatever branch they had (the user explicitly opted into that behavior
# so in-progress work isn't disturbed).
#
# `notion boxy create --branch <X>` creates the remote branch ref but
# "Skipping branch checkout for <X> (detached mode)" leaves the boxy on
# its default branch. This helper completes the checkout.
#
# notion-next location varies by boxy: /work/notion-next on the canonical
# image, ~/notion-next on some others. Probe both, prefer /work.
#   $1 boxy name (also the desired branch name)
_gw_boxy_checkout_branch() {
  local boxy="$1"
  echo "  ⇪ Checking out branch '$boxy' from origin/main..."
  notion boxy ssh "$boxy" --command "bash -lc '
    set -e
    nn=\"\"
    for d in /work/notion-next \$HOME/notion-next; do
      if [ -d \"\$d\" ]; then nn=\"\$d\"; break; fi
    done
    if [ -z \"\$nn\" ]; then
      echo \"  ⚠ notion-next not found at /work/notion-next or ~/notion-next — skipping branch checkout.\"
      exit 0
    fi
    cd \"\$nn\"
    git fetch origin main >/dev/null 2>&1
    if git rev-parse --verify --quiet refs/heads/$boxy >/dev/null 2>&1; then
      git checkout $boxy
      echo \"  ✓ Switched to existing local branch $boxy in \$nn\"
    else
      git checkout -b $boxy origin/main
      echo \"  ✓ Created branch $boxy from origin/main in \$nn\"
    fi
  '"
}

# Wait for the boxy's SSH to be reachable. Right after `notion boxy
# create` the SSH control master is still warming up; without this probe
# the first staging scp can stall for a long time on the silent retry.
# Probe command is `/bin/true` (not just `true`) — the CLI's `--command`
# validator coerces literal "true"/"false" to booleans and rejects them.
#   $1 boxy  $2 max attempts (default 15, ~30s with 2s sleep)
_gw_boxy_wait_ssh() {
  local boxy="$1" max="${2:-15}"
  echo "  ⇪ Probing SSH to $boxy..."
  local i
  for i in $(seq 1 "$max"); do
    if notion boxy ssh "$boxy" --command "/bin/true" >/dev/null 2>&1; then
      echo "  ✓ SSH ready"
      return 0
    fi
    sleep 2
  done
  echo "  ✗ SSH never became reachable after $((max * 2))s — aborting."
  return 1
}

# Stage everything the boxy needs in a single round-trip: role files, AI
# launcher, tmux setup script, and (for long-running layout) the TODO
# body + finalize script. We tar locally, `notion boxy scp` the tarball
# once, then a single ssh extracts and finalizes. Multiple sequential
# scps after a fresh create stall badly while the SSH control master is
# still warming up — batching avoids that entire failure mode.
#
#   $1 boxy name  $2 layout (d|l)
_gw_stage_boxy() {
  local boxy="$1" layout="$2"
  local tmpdir
  tmpdir=$(mktemp -d -t gwb-stage.XXXXXX) || return 1

  echo "  ⇪ Building staging bundle..."

  # Remote AI launcher. Single source of truth for how role + TODO are
  # injected into the AI command on the boxy. Mirrors `_gw_run_ai` locally
  # but runs in the boxy's shell so $(cat) and printf expand remotely.
  cat > "$tmpdir/_launch.sh" <<'LAUNCH'
#!/usr/bin/env bash
# Auto-generated by gwb. Usage: _launch.sh <role> <ai_choice> <todo_path>
role="$1"; ai="$2"; todo="$3"
role_file="$HOME/worktree-roles/${role}.md"
if [ "$ai" = "x" ] || [ "$ai" = "X" ]; then
  codex --dangerously-bypass-approvals-and-sandbox "$(printf 'Your role for this session (worktree TODO: %s):\n\n' "$todo")$(cat "$role_file")"
else
  claude --dangerously-skip-permissions --append-system-prompt "$(cat "$role_file")$(printf '\n\nWorktree TODO file: %s' "$todo")"
fi
LAUNCH
  chmod +x "$tmpdir/_launch.sh"

  # Remote tmux setup. Idempotent: re-attaches if the session exists,
  # otherwise builds it from scratch with our window/pane layout. The
  # nested tmux uses prefix C-a (outer is C-b) and an orange status bar
  # so it's visually distinct from the local session.
  cat > "$tmpdir/_setup_tmux.sh" <<'SETUPTMUX'
#!/usr/bin/env bash
# Auto-generated by gwb. Usage: _setup_tmux.sh <name> <ai> <layout>
set -e
name="$1"; ai="$2"; layout="$3"
session="boxy-${name}"
todo="$HOME/worktree-todos/${name}/TODO.md"
roles="$HOME/worktree-roles"

if tmux has-session -t "$session" 2>/dev/null; then
  exec tmux attach -t "$session"
fi

# notion-next lives at /work/notion-next on canonical boxies; some have
# it at ~/notion-next. Probe both, fall back to $HOME if neither exists
# so tmux's -c flag at least gets a valid directory.
nn=""
for d in /work/notion-next "$HOME/notion-next"; do
  if [ -d "$d" ]; then nn="$d"; break; fi
done
[ -z "$nn" ] && nn="$HOME"

# Window 0 — main shell in notion-next.
tmux new-session -d -s "$session" -n "main" -c "$nn"

# Inner prefix C-a so it doesn't fight the outer (local) tmux's C-b.
# `send-prefix` lets C-a C-a deliver a literal C-a (shell start-of-line).
# Orange status bar so the nested level is obvious at a glance.
tmux set-option -t "$session" prefix C-a
tmux set-option -t "$session" prefix2 None
tmux bind-key   -T prefix C-a send-prefix
tmux set-option -t "$session" status-bg colour208
tmux set-option -t "$session" status-fg black

# Window 1 — extra remote shell.
tmux new-window -t "$session:1" -c "$nn" -n "shell"

if [ "$layout" = "l" ] || [ "$layout" = "L" ]; then
  # Window 2 — agents (vertical split, labeled panes).
  tmux new-window -t "$session:2" -c "$nn" -n "agents"
  tmux set-window-option -t "$session:2" pane-border-status top
  tmux set-window-option -t "$session:2" pane-border-format " #{@role} "
  tmux split-window      -t "$session:2" -h -c "$nn"
  tmux set-option -p -t "$session:2.0" @role "implementor"
  tmux set-option -p -t "$session:2.1" @role "researcher"
  tmux send-keys  -t "$session:2.0" "$roles/_launch.sh implementor $ai $todo" C-m
  tmux send-keys  -t "$session:2.1" "$roles/_launch.sh researcher $ai $todo" C-m

  # Window 3 — adversarial reviewer.
  tmux new-window -t "$session:3" -c "$nn" -n "review"
  tmux set-window-option -t "$session:3" pane-border-status top
  tmux set-window-option -t "$session:3" pane-border-format " #{@role} "
  tmux set-option -p -t "$session:3.0" @role "adversarial"
  tmux send-keys  -t "$session:3.0" "$roles/_launch.sh adversarial $ai $todo" C-m
else
  # Window 2 — single AI, no role priming.
  tmux new-window -t "$session:2" -c "$nn" -n "ai"
  if [ "$ai" = "x" ] || [ "$ai" = "X" ]; then
    tmux send-keys -t "$session:2" "codex --dangerously-bypass-approvals-and-sandbox" C-m
  else
    tmux send-keys -t "$session:2" "claude --dangerously-skip-permissions" C-m
  fi
fi

tmux select-window -t "$session:0"
exec tmux attach -t "$session"
SETUPTMUX
  chmod +x "$tmpdir/_setup_tmux.sh"

  cp "$_GW_ROLES_DIR/implementor.md" \
     "$_GW_ROLES_DIR/researcher.md" \
     "$_GW_ROLES_DIR/adversarial.md" \
     "$tmpdir/" || { rm -rf "$tmpdir"; return 1; }

  # Long-running layout: include the TODO body in the tarball. The
  # finalize script (below) moves it into place on the boxy if there
  # isn't already a TODO for this boxy name.
  local include_todo=0
  if [[ "$layout" =~ ^[Ll]$ ]]; then
    include_todo=1
    cat > "$tmpdir/_todo_body.md" <<TODOEOF
# $boxy — Boxy TODO

- Created: $(date '+%Y-%m-%d')
- Boxy: \`$boxy\`

## Notes

## Tasks

- [ ]
TODOEOF
  fi

  # Finalize script — runs once on the boxy after unpack. Moves files
  # into ~/worktree-roles, optionally creates the TODO + symlink, then
  # deletes itself.
  cat > "$tmpdir/_finalize.sh" <<FINALIZE
#!/usr/bin/env bash
set -e
# NOTE: we intentionally do NOT probe for tmux here. This script runs
# under \`bash -lc\` which doesn't activate mise (the user has tmux via
# mise — \`bash -lc 'command -v tmux'\` returns empty even though tmux
# is on the interactive PATH). \`_setup_tmux.sh\` runs in the user's
# interactive shell where mise has activated tmux, so any genuine
# tmux-missing case surfaces there with a clear "command not found".

mkdir -p "\$HOME/worktree-roles"
mv -f "\$HOME/_gw_unpack"/_launch.sh     "\$HOME/worktree-roles/_launch.sh"
mv -f "\$HOME/_gw_unpack"/_setup_tmux.sh "\$HOME/worktree-roles/_setup_tmux.sh"
mv -f "\$HOME/_gw_unpack"/implementor.md "\$HOME/worktree-roles/implementor.md"
mv -f "\$HOME/_gw_unpack"/researcher.md  "\$HOME/worktree-roles/researcher.md"
mv -f "\$HOME/_gw_unpack"/adversarial.md "\$HOME/worktree-roles/adversarial.md"
chmod +x "\$HOME/worktree-roles/_launch.sh" "\$HOME/worktree-roles/_setup_tmux.sh"

if [ "$include_todo" = "1" ]; then
  mkdir -p "\$HOME/worktree-todos/$boxy"
  todo_file="\$HOME/worktree-todos/$boxy/TODO.md"
  if [ ! -f "\$todo_file" ]; then
    mv "\$HOME/_gw_unpack/_todo_body.md" "\$todo_file"
    echo "  📝 Created persistent TODO on boxy: \$todo_file"
  else
    echo "  📝 Re-attached existing TODO on boxy: \$todo_file"
  fi
  # notion-next is at /work/notion-next on canonical boxies; some have
  # it at ~/notion-next instead. Probe both.
  nn=""
  for d in /work/notion-next "\$HOME/notion-next"; do
    if [ -d "\$d" ]; then nn="\$d"; break; fi
  done
  if [ -n "\$nn" ]; then
    ln -sfn "\$todo_file" "\$nn/WORKTREE-TODO.md"
    exclude="\$nn/.git/info/exclude"
    if [ -f "\$exclude" ] && ! grep -qxF "WORKTREE-TODO.md" "\$exclude"; then
      echo "WORKTREE-TODO.md" >> "\$exclude"
    fi
  fi
fi

rm -rf "\$HOME/_gw_unpack" "\$HOME/_gw_staging.tgz"
FINALIZE
  chmod +x "$tmpdir/_finalize.sh"

  # Bundle. Use a relative tar path so extraction lands in ~/_gw_unpack
  # on the boxy without leaking the local mktemp path.
  ( cd "$tmpdir" && tar -czf staging.tgz \
      _launch.sh _setup_tmux.sh _finalize.sh \
      implementor.md researcher.md adversarial.md \
      $([ "$include_todo" = "1" ] && echo "_todo_body.md") )

  echo "  ⇪ Uploading staging bundle to $boxy..."
  notion boxy scp "$tmpdir/staging.tgz" "$boxy:~/_gw_staging.tgz" || {
    rm -rf "$tmpdir"
    return 1
  }

  echo "  ⇪ Unpacking on $boxy..."
  notion boxy ssh "$boxy" --command "bash -lc 'mkdir -p ~/_gw_unpack && tar -xzf ~/_gw_staging.tgz -C ~/_gw_unpack && bash ~/_gw_unpack/_finalize.sh'" || {
    rm -rf "$tmpdir"
    return 1
  }

  rm -rf "$tmpdir"
  echo "  ✓ Staging complete"
}

# Build the local tmux session for a boxy. The local session has a single
# window that SSHes into the boxy and execs into a remote tmux session
# (`boxy-<name>` on the boxy) where the real window/pane layout lives.
# This means agents survive local tmux death / SSH disconnects: closing
# your laptop drops the SSH but the remote tmux keeps the AIs running.
# Re-running `gwb` re-establishes the SSH + attaches to the same remote.
#
# We run the setup script as ssh's REMOTE COMMAND (via --command) rather
# than send-keys'ing two lines (ssh + script) into the local pane. The
# two-step approach silently fails: local zsh's line editor reads both
# lines into its in-process input buffer before executing the first
# (ssh), so when ssh inherits stdin the second line is already gone
# from the kernel pty. The orphaned second line eventually runs in
# LOCAL zsh after ssh exits — definitely not what we want.
#
# `bash -ilc` is intentional: -i sources ~/.bashrc on the boxy (where
# mise activation lives, putting tmux on PATH); -l also sources the
# login profile; -c runs our setup invocation in this enriched env.
#
#   $1 boxy  $2 ai_choice (c|x)  $3 layout (d|l)  $4 fresh_create (0|1)
_gw_build_boxy_session() {
  local boxy="$1" ai="$2" layout="$3" fresh="${4:-0}"
  local session="boxy-$boxy"

  if tmux has-session -t "$session" 2>/dev/null; then
    echo "Local tmux session '$session' already exists — switching to it."
    if [ -n "$TMUX" ]; then
      tmux switch-client -t "$session"
    else
      tmux attach-session -t "$session"
    fi
    return 0
  fi

  _gw_boxy_wait_ssh "$boxy" || return 1
  _gw_stage_boxy "$boxy" "$layout" || return 1
  if [ "$fresh" = "1" ]; then
    _gw_boxy_checkout_branch "$boxy" || return 1
  fi

  tmux new-session -d -s "$session" -n "boxy" -c "$HOME"
  tmux send-keys -t "$session:0" \
    "notion boxy ssh $boxy --command \"bash -ilc 'bash ~/worktree-roles/_setup_tmux.sh $boxy $ai $layout'\"" \
    C-m

  if [ -n "$TMUX" ]; then
    tmux switch-client -t "$session"
  else
    tmux attach-session -t "$session"
  fi
}

gwa() {
  if [ -z "$1" ]; then
    echo "Usage: gwa <branch-name>"
    return 1
  fi


  local branch="$1"
  local worktree_path="$HOME/worktrees/$branch"


  # Create a new tmux session with the branch name (detached)
  tmux new-session -d -s "$branch" -n "main" 2>/dev/null || true


  # Add worktree — adopt origin/$branch if it exists (sets upstream tracking
  # automatically), otherwise branch from origin/main. Gitlinker and similar
  # tools fall into an O(remote-branches) slow path without upstream set.
  git fetch origin main "$branch" 2>/dev/null || git fetch origin main
  if git rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null 2>&1; then
    echo "Adopting existing remote branch origin/$branch"
    git worktree add -b "$branch" "$worktree_path" "origin/$branch"
  else
    git worktree add "$worktree_path" -b "$branch" origin/main
  fi

  # Set path
  tmux attach -c "$worktree_path"

  # Send commands to the first window of the new tmux session
  tmux send-keys -t "$branch:0" "cd $worktree_path" C-m
  tmux send-keys -t "$branch:0" "notion install" C-m


  # Create second window
  tmux new-window -t "$branch:1" -c "$worktree_path" -n "shell"


  # Choose layout
  printf "Layout: [d]efault or [l]ong-running? [d/l] "
  read -r layout_choice </dev/tty
  layout_choice=${layout_choice:-d}

  # Choose AI assistant for this worktree
  printf "AI assistant: [c]laude or code[x]? [c/x] "
  read -r ai_choice </dev/tty
  ai_choice=${ai_choice:-c}

  # Create the persistent TODO first so the agents can read it on launch.
  _gw_create_worktree_todo "$branch" "$worktree_path" "$layout_choice"
  _gw_create_ai_windows    "$branch" "$worktree_path" "$ai_choice" "$layout_choice"


  # Set default directory for new windows in this session
  tmux set-option -t "$branch" default-command "cd $worktree_path; exec \$SHELL"


  # Switch back to the first window
  tmux select-window -t "$branch:0"


  # Switch to the new session
  if [ -n "$TMUX" ]; then
    # We're inside tmux, so use switch-client
    tmux switch-client -t "$branch"
  else
    # We're not in tmux, so attach
    tmux attach-session -t "$branch"
  fi
}

gwr() {
  if [ -z "$1" ]; then
    echo "Usage: gwr <branch-name>"
    return 1
  fi

  local branch="$1"
  local worktree_path="$HOME/worktrees/$branch"

  # Kill tmux session if it exists
  if tmux has-session -t "$branch" 2>/dev/null; then
    tmux kill-session -t "$branch"
    echo "Killed tmux session: $branch"
  fi

  # Remove worktree if it exists
  if [ -d "$worktree_path" ]; then
    git worktree remove "$worktree_path" --force
    echo "Removed worktree: $worktree_path"
  fi

  # Delete branch if it exists
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git branch -D "$branch"
    echo "Deleted branch: $branch"
  fi

  # Persistent TODO file (long-running layout) lives outside the worktree and
  # intentionally survives removal.
  local todo_file="$HOME/Documents/plans/worktree-todos/$branch/TODO.md"
  [ -f "$todo_file" ] && echo "Persistent TODO retained: $todo_file"
}

# Ensure the three primary tmux sessions exist. Numeric prefixes (1-, 2-, 3-)
# sort above branch-named worktree sessions in `C-b s` and `tmux ls`, so
# primaries appear on top. Idempotent — safe to re-run.
_gw_ensure_primaries() {
  local primaries=("1-main" "2-exploration" "3-investigation")
  local created=()
  local s
  for s in "${primaries[@]}"; do
    if ! tmux has-session -t "$s" 2>/dev/null; then
      tmux new-session -d -s "$s" -n "main" -c "$HOME"
      created+=("$s")
    fi
  done
  if [ ${#created[@]} -gt 0 ]; then
    echo "Bootstrapped primary sessions: ${created[*]}"
  else
    echo "Primary sessions already exist: ${primaries[*]}"
  fi
}

gwrecover() {
  # Spawn primaries first so they sit above worktree sessions in `C-b s`.
  _gw_ensure_primaries
  echo ""

  local created=()
  local deleted=()
  local skipped=()

  # Get worktrees with their branches, skip the first (main repo)
  # Format: worktree_path<TAB>branch_name
  local worktrees
  worktrees=$(git worktree list --porcelain | awk '
    /^worktree /{ wt=$2 }
    /^branch /{ sub("refs/heads/","",$2); print wt "\t" $2 }
  ' | tail -n +2)

  if [ -z "$worktrees" ]; then
    echo "No worktrees found to recover."
    return 0
  fi

  echo "Found worktrees to recover:\n"

  while IFS=$'\t' read -r worktree_path branch; do
    # Heal missing upstream tracking. Without it, tools that resolve "is this
    # rev on a remote?" fall back to `git branch -r --contains`, which is
    # O(remote-branches) and takes minutes in repos with tens of thousands.
    if ! git -C "$worktree_path" rev-parse --abbrev-ref "$branch@{u}" >/dev/null 2>&1; then
      if git -C "$worktree_path" rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null 2>&1; then
        git -C "$worktree_path" branch --set-upstream-to="origin/$branch" "$branch" >/dev/null 2>&1 \
          && echo "  ✓ Set upstream: $branch → origin/$branch"
      fi
    fi

    local session_name=$(basename "$worktree_path")

    # Skip if tmux session already exists
    if tmux has-session -t "$session_name" 2>/dev/null; then
      echo "  $session_name ($branch) — session already exists, skipping"
      skipped+=("$session_name")
      continue
    fi

    printf "  %s [branch: %s] (%s)\n" "$session_name" "$branch" "$worktree_path"
    printf "  Create tmux session? [Y/n] "
    read -r reply </dev/tty
    reply=${reply:-Y}

    if [[ "$reply" =~ ^[Yy]$ ]]; then
      # Choose AI assistant
      printf "  AI assistant: [c]laude or code[x]? [c/x] "
      read -r ai_choice </dev/tty
      ai_choice=${ai_choice:-c}

      # Choose layout
      printf "  Layout: [d]efault or [l]ong-running? [d/l] "
      read -r layout_choice </dev/tty
      layout_choice=${layout_choice:-d}

      # Recreate tmux session (mirrors gwa layout). Create the persistent
      # TODO first so the agents can read it on launch.
      tmux new-session -d -s "$session_name" -c "$worktree_path" -n "main"
      tmux new-window -t "$session_name:1" -c "$worktree_path" -n "shell"
      _gw_create_worktree_todo "$session_name" "$worktree_path" "$layout_choice"
      _gw_create_ai_windows    "$session_name" "$worktree_path" "$ai_choice" "$layout_choice"
      tmux set-option -t "$session_name" default-command "cd $worktree_path; exec \$SHELL"
      tmux select-window -t "$session_name:0"
      echo "  ✓ Created session: $session_name"
      created+=("$session_name")
    else
      printf "  Delete worktree and branch '%s'? [y/N] " "$branch"
      read -r del_reply </dev/tty
      del_reply=${del_reply:-N}

      if [[ "$del_reply" =~ ^[Yy]$ ]]; then
        # Inline deletion instead of gwr — we already have the correct
        # branch name and worktree path, while gwr infers them from one arg.
        if tmux has-session -t "$session_name" 2>/dev/null; then
          tmux kill-session -t "$session_name"
          echo "  Killed tmux session: $session_name"
        fi
        # Detach the slow parts (worktree rm + branch delete) so the
        # interactive loop moves on immediately and the function returns
        # without waiting on them at the end.
        (
          if [ -d "$worktree_path" ]; then
            git worktree remove "$worktree_path" --force
          fi
          if git show-ref --verify --quiet "refs/heads/$branch"; then
            git branch -D "$branch"
          fi
        ) >/dev/null 2>&1 &!
        echo "  ⏳ Queued deletion: $session_name"
        deleted+=("$session_name")
      else
        echo "  — Skipped"
        skipped+=("$session_name")
      fi
    fi
    echo ""
  done <<< "$worktrees"

  echo "--- Summary ---"
  [ ${#created[@]} -gt 0 ] && echo "  Created: ${created[*]}"
  [ ${#deleted[@]} -gt 0 ] && echo "  Deleted: ${deleted[*]}"
  [ ${#skipped[@]} -gt 0 ] && echo "  Skipped: ${skipped[*]}"

  if [ ${#created[@]} -gt 0 ]; then
    echo "\nActive sessions:"
    tmux ls 2>/dev/null
  fi
}

# gwb — Boxy workstream automation. Mirrors `gwa` but every pane in the
# resulting tmux session SSHes into a Notion Boxy remote dev environment.
# The local tmux session is prefixed `boxy-` so it sorts separately from
# worktree sessions in `C-b s`.
gwb() {
  if [ -z "$1" ]; then
    echo "Usage: gwb <name>"
    return 1
  fi

  local boxy="$1"
  local session="boxy-$boxy"

  # If the local tmux session already exists, just switch to it. The
  # remote boxy is fine; rebuilding panes on top would be messy.
  if tmux has-session -t "$session" 2>/dev/null; then
    echo "Local tmux session '$session' already exists — switching to it."
    if [ -n "$TMUX" ]; then
      tmux switch-client -t "$session"
    else
      tmux attach-session -t "$session"
    fi
    return 0
  fi

  local fresh_create=0
  if _gw_boxy_exists "$boxy"; then
    echo "Boxy '$boxy' already exists — skipping create."
  else
    fresh_create=1
    printf "Image flavor: [n]otion-next, [m]ail, or [d]ata? [n/m/d] "
    local flavor_choice
    read -r flavor_choice </dev/tty
    flavor_choice=${flavor_choice:-n}

    local flavor_flag=""
    case "$flavor_choice" in
      [Mm]) flavor_flag="--withMail" ;;
      [Dd]) flavor_flag="--withData" ;;
      *)    flavor_flag="" ;;
    esac

    echo "Creating boxy '$boxy' (this can take a couple of minutes)..."
    # Capture output so we can recover the actual name the CLI chose.
    # `notion boxy create` may auto-suffix if the requested name is taken
    # (printed as "Name '<x>' is taken, next available: '<x>-N'") and the
    # canonical "Current machine set to: <actual>" line tells us what
    # ultimately got created. Without this our staging targets the wrong
    # host and silently times out on SSH.
    local create_log
    create_log=$(mktemp -t gwb-create.XXXXXX) || return 1
    if [ -n "$flavor_flag" ]; then
      notion boxy create "$boxy" --branch "$boxy" "$flavor_flag" --detached 2>&1 | tee "$create_log"
    else
      notion boxy create "$boxy" --branch "$boxy" --detached 2>&1 | tee "$create_log"
    fi
    local create_rc=${pipestatus[1]}
    if [ "$create_rc" != "0" ]; then
      rm -f "$create_log"
      echo "notion boxy create failed (status $create_rc)"
      return 1
    fi

    local actual
    actual=$(grep -m1 '^Current machine set to:' "$create_log" \
             | sed 's/^Current machine set to: //' \
             | awk '{print $1}')
    rm -f "$create_log"
    if [ -z "$actual" ]; then
      echo "Could not parse created boxy name from CLI output. Run 'notion boxy ls' and retry with the actual name."
      return 1
    fi
    if [ "$actual" != "$boxy" ]; then
      echo "  ℹ CLI created boxy as '$actual' (local session will be boxy-$actual)."
      boxy="$actual"
      session="boxy-$boxy"
    fi
  fi

  printf "Layout: [d]efault or [l]ong-running? [d/l] "
  local layout_choice
  read -r layout_choice </dev/tty
  layout_choice=${layout_choice:-d}

  printf "AI assistant: [c]laude or code[x]? [c/x] "
  local ai_choice
  read -r ai_choice </dev/tty
  ai_choice=${ai_choice:-c}

  _gw_build_boxy_session "$boxy" "$ai_choice" "$layout_choice" "$fresh_create"
}

# gwbr — Counterpart to gwb. Kills the local tmux session, then prompts
# before destroying the boxy (irreversible).
gwbr() {
  if [ -z "$1" ]; then
    echo "Usage: gwbr <name>"
    return 1
  fi

  local boxy="$1"
  local session="boxy-$boxy"

  if tmux has-session -t "$session" 2>/dev/null; then
    tmux kill-session -t "$session"
    echo "Killed tmux session: $session"
  fi

  if _gw_boxy_exists "$boxy"; then
    printf "Destroy boxy '%s'? This is irreversible. [y/N] " "$boxy"
    local del_reply
    read -r del_reply </dev/tty
    del_reply=${del_reply:-N}
    if [[ "$del_reply" =~ ^[Yy]$ ]]; then
      notion boxy destroy "$boxy"
    else
      echo "  — Boxy retained: $boxy"
    fi
  else
    echo "  No remote boxy named '$boxy' to destroy."
  fi
}

# gwbrecover — Walk `notion boxy ls` and, for each remote boxy without a
# local tmux session, offer to recreate the session (mirroring gwb) or
# destroy the boxy. Useful after a reboot wipes local tmux state.
gwbrecover() {
  local boxes
  boxes=$(notion boxy ls 2>/dev/null | awk '
    /^---/ { in_data = 1; next }
    in_data && NF > 0 { print $1 }
  ')

  if [ -z "$boxes" ]; then
    echo "No boxies found to recover."
    return 0
  fi

  echo "Found boxies to recover:\n"

  local created=()
  local destroyed=()
  local skipped=()

  while IFS= read -r boxy; do
    [ -z "$boxy" ] && continue
    local session="boxy-$boxy"

    if tmux has-session -t "$session" 2>/dev/null; then
      echo "  $boxy — local session already exists, skipping"
      skipped+=("$boxy")
      continue
    fi

    printf "  %s\n" "$boxy"
    printf "  Create local tmux session? [Y/n] "
    local reply
    read -r reply </dev/tty
    reply=${reply:-Y}

    if [[ "$reply" =~ ^[Yy]$ ]]; then
      printf "  AI assistant: [c]laude or code[x]? [c/x] "
      local ai_choice
      read -r ai_choice </dev/tty
      ai_choice=${ai_choice:-c}

      printf "  Layout: [d]efault or [l]ong-running? [d/l] "
      local layout_choice
      read -r layout_choice </dev/tty
      layout_choice=${layout_choice:-d}

      _gw_build_boxy_session "$boxy" "$ai_choice" "$layout_choice" 0
      created+=("$boxy")
    else
      printf "  Destroy boxy '%s'? [y/N] " "$boxy"
      local del_reply
      read -r del_reply </dev/tty
      del_reply=${del_reply:-N}
      if [[ "$del_reply" =~ ^[Yy]$ ]]; then
        # Queue destruction asynchronously — `notion boxy destroy` can
        # take several seconds and we don't want to block the loop.
        ( notion boxy destroy "$boxy" >/dev/null 2>&1 ) &!
        echo "  ⏳ Queued destroy: $boxy"
        destroyed+=("$boxy")
      else
        echo "  — Skipped"
        skipped+=("$boxy")
      fi
    fi
    echo ""
  done <<< "$boxes"

  echo "--- Summary ---"
  [ ${#created[@]} -gt 0 ]   && echo "  Created:   ${created[*]}"
  [ ${#destroyed[@]} -gt 0 ] && echo "  Destroyed: ${destroyed[*]}"
  [ ${#skipped[@]} -gt 0 ]   && echo "  Skipped:   ${skipped[*]}"
}
