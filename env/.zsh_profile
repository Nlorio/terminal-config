gwa() {
  if [ -z "$1" ]; then
    echo "Usage: gwa <branch-name>"
    return 1
  fi

  local repo_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "gwa: not inside a git repository"
    return 1
  }
  local repo_name
  repo_name="$(basename "$repo_root")"

  local branch="$1"
  local worktree_path="$HOME/worktrees/$repo_name/$branch"

  # Create a new tmux session named after the branch (detached)
  tmux new-session -d -s "$branch" -c "$worktree_path" 2>/dev/null || true

  # Add worktree (create branch if it doesn't already exist)
  git -C "$repo_root" branch "$branch" 2>/dev/null || true
  git -C "$repo_root" worktree add "$worktree_path" "$branch" || return 1

  # Window 0: working shell in the worktree
  tmux send-keys -t "$branch:0" "cd $worktree_path" C-m

  # Window 1: second working shell
  tmux new-window -t "$branch:1" -c "$worktree_path"

  # Window 2: claude
  tmux new-window -t "$branch:2" -c "$worktree_path"
  tmux send-keys -t "$branch:2" "claude --dangerously-skip-permissions" C-m

  # Default directory for new windows in this session
  tmux set-option -t "$branch" default-command "cd $worktree_path; exec \$SHELL"

  tmux select-window -t "$branch:0"

  if [ -n "$TMUX" ]; then
    tmux switch-client -t "$branch"
  else
    tmux attach-session -t "$branch"
  fi
}

gwr() {
  if [ -z "$1" ]; then
    echo "Usage: gwr <branch-name>"
    return 1
  fi

  local repo_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "gwr: not inside a git repository"
    return 1
  }
  local repo_name
  repo_name="$(basename "$repo_root")"

  local branch="$1"
  local worktree_path="$HOME/worktrees/$repo_name/$branch"

  # Kill tmux session if it exists
  if tmux has-session -t "$branch" 2>/dev/null; then
    tmux kill-session -t "$branch"
    echo "Killed tmux session: $branch"
  fi

  # Remove worktree if it exists
  if [ -d "$worktree_path" ]; then
    git -C "$repo_root" worktree remove "$worktree_path" --force
    echo "Removed worktree: $worktree_path"
  fi

  # Delete branch if it exists
  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$repo_root" branch -D "$branch"
    echo "Deleted branch: $branch"
  fi
}

# gwrecover — interactively rebuild (or delete) tmux sessions for existing
# worktrees. Useful after a reboot or `tmux kill-server`, where the worktrees
# on disk survive but their sessions are gone. Mirrors gwa's window layout.
gwrecover() {
  local created=()
  local deleted=()
  local skipped=()

  # Get worktrees with their branches, skip the first (main repo)
  # Format: worktree_path<TAB>branch_name
  local worktrees
  worktrees=$(git worktree list --porcelain | awk '
    /^worktree /{ wt=$2 }
    /^branch /{ sub("refs/heads/","",$2); print wt "\t" $2 }
  ' | tail -n +2)

  if [ -z "$worktrees" ]; then
    echo "No worktrees found to recover."
    return 0
  fi

  echo "Found worktrees to recover:\n"

  while IFS=$'\t' read -r worktree_path branch; do
    local session_name=$(basename "$worktree_path")

    # Skip if tmux session already exists
    if tmux has-session -t "$session_name" 2>/dev/null; then
      echo "  $session_name ($branch) — session already exists, skipping"
      skipped+=("$session_name")
      continue
    fi

    printf "  %s [branch: %s] (%s)\n" "$session_name" "$branch" "$worktree_path"
    printf "  Create tmux session? [Y/n] "
    read -r reply </dev/tty
    reply=${reply:-Y}

    if [[ "$reply" =~ ^[Yy]$ ]]; then
      # Recreate tmux session (mirrors gwa layout)
      tmux new-session -d -s "$session_name" -c "$worktree_path"
      tmux new-window -t "$session_name:1" -c "$worktree_path"
      tmux new-window -t "$session_name:2" -c "$worktree_path"
      tmux send-keys -t "$session_name:2" "claude --dangerously-skip-permissions" C-m
      tmux set-option -t "$session_name" default-command "cd $worktree_path; exec \$SHELL"
      tmux select-window -t "$session_name:0"
      echo "  ✓ Created session: $session_name"
      created+=("$session_name")
    else
      printf "  Delete worktree and branch '%s'? [y/N] " "$branch"
      read -r del_reply </dev/tty
      del_reply=${del_reply:-N}

      if [[ "$del_reply" =~ ^[Yy]$ ]]; then
        # Inline deletion instead of gwr — we already have the correct
        # branch name and worktree path, while gwr infers them from one arg.
        if tmux has-session -t "$session_name" 2>/dev/null; then
          tmux kill-session -t "$session_name"
          echo "  Killed tmux session: $session_name"
        fi
        if [ -d "$worktree_path" ]; then
          git worktree remove "$worktree_path" --force
          echo "  Removed worktree: $worktree_path"
        fi
        if git show-ref --verify --quiet "refs/heads/$branch"; then
          git branch -D "$branch"
          echo "  Deleted branch: $branch"
        fi
        deleted+=("$session_name")
      else
        echo "  — Skipped"
        skipped+=("$session_name")
      fi
    fi
    echo ""
  done <<< "$worktrees"

  echo "--- Summary ---"
  [ ${#created[@]} -gt 0 ] && echo "  Created: ${created[*]}"
  [ ${#deleted[@]} -gt 0 ] && echo "  Deleted: ${deleted[*]}"
  [ ${#skipped[@]} -gt 0 ] && echo "  Skipped: ${skipped[*]}"

  if [ ${#created[@]} -gt 0 ]; then
    echo "\nActive sessions:"
    tmux ls 2>/dev/null
  fi
}
