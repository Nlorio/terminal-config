gwa() {
  if [ -z "$1" ]; then
    echo "Usage: gwa <branch-name>"
    return 1
  fi

  local repo_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "gwa: not inside a git repository"
    return 1
  }
  local repo_name
  repo_name="$(basename "$repo_root")"

  local branch="$1"
  local worktree_path="$HOME/worktrees/$repo_name/$branch"

  # Create a new tmux session named after the branch (detached)
  tmux new-session -d -s "$branch" -c "$worktree_path" 2>/dev/null || true

  # Add worktree (create branch if it doesn't already exist)
  git -C "$repo_root" branch "$branch" 2>/dev/null || true
  git -C "$repo_root" worktree add "$worktree_path" "$branch" || return 1

  # Window 0: working shell in the worktree
  tmux send-keys -t "$branch:0" "cd $worktree_path" C-m

  # Window 1: second working shell
  tmux new-window -t "$branch:1" -c "$worktree_path"

  # Window 2: claude
  tmux new-window -t "$branch:2" -c "$worktree_path"
  tmux send-keys -t "$branch:2" "claude --dangerously-skip-permissions" C-m

  # Default directory for new windows in this session
  tmux set-option -t "$branch" default-command "cd $worktree_path; exec \$SHELL"

  tmux select-window -t "$branch:0"

  if [ -n "$TMUX" ]; then
    tmux switch-client -t "$branch"
  else
    tmux attach-session -t "$branch"
  fi
}

gwr() {
  if [ -z "$1" ]; then
    echo "Usage: gwr <branch-name>"
    return 1
  fi

  local repo_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "gwr: not inside a git repository"
    return 1
  }
  local repo_name
  repo_name="$(basename "$repo_root")"

  local branch="$1"
  local worktree_path="$HOME/worktrees/$repo_name/$branch"

  # Kill tmux session if it exists
  if tmux has-session -t "$branch" 2>/dev/null; then
    tmux kill-session -t "$branch"
    echo "Killed tmux session: $branch"
  fi

  # Remove worktree if it exists
  if [ -d "$worktree_path" ]; then
    git -C "$repo_root" worktree remove "$worktree_path" --force
    echo "Removed worktree: $worktree_path"
  fi

  # Delete branch if it exists
  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$repo_root" branch -D "$branch"
    echo "Deleted branch: $branch"
  fi
}
