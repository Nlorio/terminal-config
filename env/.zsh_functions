# Custom shell functions

# Preview candidate p10k color schemes as live swatches + a sample prompt,
# rendered on the tiki-love-dark background. Pick a number, then have the
# palette applied to ~/.p10k-dark.zsh. Columns: secondary / dir / prompt / git.
p10k-preview() {
  local -A schemes
  schemes=(
    "1. Sunset Coral (current)" "EAB0A0 F0A84C F4C06C E89070 F07A6F"
    "2. Amber Mono"             "B0916A F0A84C F4C06C E8A060 F07A6F"
    "3. Jungle Tiki"            "8ACF7A F0A84C F4C06C 7AB89A F07A6F"
    "4. Lagoon"                 "7AB89A F0A84C F4C06C 8ACF7A F07A6F"
    "5. Ember Glow"             "E8A060 F0C06C F4E8D0 E89070 F07A6F"
    "6. Sage Revival"           "A0B08A F0A84C F4C06C 8ACF7A F07A6F"
    "7. Driftwood"              "C9A98A E8A060 F4E8D0 A0B08A F07A6F"
    "8. Hibiscus"               "E89070 F0A84C F4C06C E85A4F F07A6F"
    "9. Tide Pool"              "5C9A7A E8A060 F0C06C F4E8D0 F07A6F"
    "10. Midnight Tiki"         "8A9A6A F0C06C F4E8D0 7AB89A F07A6F"
  )
  local order=(
    "1. Sunset Coral (current)" "2. Amber Mono" "3. Jungle Tiki" "4. Lagoon"
    "5. Ember Glow" "6. Sage Revival" "7. Driftwood" "8. Hibiscus"
    "9. Tide Pool" "10. Midnight Tiki"
  )
  local sw() { local h=$1 r g b; r=$((16#${h[1,2]})) g=$((16#${h[3,4]})) b=$((16#${h[5,6]})); printf "\e[48;2;%d;%d;%dm   \e[0m" $r $g $b; }
  local fg() { local h=$1 r g b; r=$((16#${h[1,2]})) g=$((16#${h[3,4]})) b=$((16#${h[5,6]})); printf "\e[38;2;%d;%d;%dm" $r $g $b; }
  local bg="\e[48;2;26;20;16m"
  local name cols sec dir pr git
  printf "%-26s  %-3s %-3s %-3s %-3s   live prompt sample\n" "scheme" "2nd" "dir" "❯" "git"
  for name in "${order[@]}"; do
    cols=(${=schemes[$name]}); sec=$cols[1] dir=$cols[2] pr=$cols[3] git=$cols[4]
    printf "%-26s  " "$name"
    sw $sec; printf " "; sw $dir; printf " "; sw $pr; printf " "; sw $git
    printf "   ${bg} $(fg $sec)nlorio@sage $(fg $dir)~/wt/hcc $(fg $git)⎇ main $(fg $pr)❯\e[0m\n"
  done
}


# --- process memory triage ----------------------------------------------------
# Each Claude Code session and each nvim instance spawns its own `tsgo`
# TypeScript LSP (and various node helpers/MCP servers). Against the notion-next
# monorepo a single tsgo can balloon to 20-30GB, so a few stale sessions quietly
# eat all your RAM. The hogs are usually the ones launched by Claude Code's
# lspMcp server, which (unlike nvim) does not inherit the GOMEMLIMIT cap. These
# helpers map every heavy process back to the tmux pane + app that owns it, so
# you can tell which session/window/agent to close vs which stray to kill.
#
# Triage flow: `mem-owners` (pressure line + per-process MEM/%CPU, ⚠ flags the
# runaway shape) → `proc-impact <pid>` for a precise CPU read on a suspect →
# `tsgo-reap` to kill. Key lesson baked in: memory size alone is misleading —
# what makes you slow is system pressure (full RAM → swap thrash), and a heavy
# process is only worth killing urgently if it's *also* burning CPU.

# Walk up from a pid until an ancestor matches a live tmux pane; print "session
# window:name" for that pane, else nothing. $2 may pass a cached `tmux
# list-panes` listing (pane_pid + label per line) to avoid re-querying per call.
_proc_pane() {
  local cur=$1 panes=${2:-$(tmux list-panes -a -F '#{pane_pid} #{session_name} #{window_index}:#{window_name}' 2>/dev/null)} pane
  while [ -n "$cur" ] && [ "$cur" != "1" ]; do
    pane=$(print -r -- "$panes" | awk -v c="$cur" '$1==c {$1=""; sub(/^ +/,""); print; exit}')
    [ -n "$pane" ] && { print -r -- "$pane"; return; }
    cur=$(ps -o ppid= -p "$cur" 2>/dev/null | tr -d ' ')
  done
}

# Walk up from a pid to the owning interactive app (claude/nvim); else print "-".
_proc_app() {
  local cur=$1
  while [ -n "$cur" ] && [ "$cur" != "1" ]; do
    case "$(ps -o command= -p "$cur" 2>/dev/null)" in
      claude|*/claude) print -- claude; return ;;
      *nvim*)          print -- nvim;   return ;;
    esac
    cur=$(ps -o ppid= -p "$cur" 2>/dev/null | tr -d ' ')
  done
  print -- -
}

# Convert a ps time field ([dd-][hh:]mm:ss[.ss]) to seconds. Handles both the
# cputime form (mm:ss.ss, minutes can exceed 60) and etime form (dd-hh:mm:ss).
_to_secs() {
  print -r -- "$1" | awk '{ t=$0; d=0
    if (t ~ /-/) { split(t,a,"-"); d=a[1]; t=a[2] }
    n=split(t,b,":"); s=0; for (i=1;i<=n;i++) s=s*60+b[i]
    printf "%.2f", d*86400 + s }'
}

# One-line system memory-pressure summary. This is the context that decides
# whether a big process actually makes you slow: lots of RAM in use is fine
# until `free` hits ~0 and the machine starts compressing/swapping. Learned the
# hard way — a 16GB process is harmless on 128GB right up until total demand
# crosses physical RAM, then swap thrash (not the GB number) is what lags you.
_mem_pressure() {
  emulate -L zsh
  local pg=$(sysctl -n hw.pagesize) total=$(sysctl -n hw.memsize) vm=$(vm_stat)
  local free=$(print -r -- "$vm" | awk '/Pages free/{gsub(/\./,"",$3);print $3}')
  local spec=$(print -r -- "$vm" | awk '/Pages speculative/{gsub(/\./,"",$3);print $3}')
  local comp=$(print -r -- "$vm" | awk '/occupied by compressor/{gsub(/\./,"",$5);print $5}')
  local sw=$(sysctl -n vm.swapusage)
  local sw_used=$(print -r -- "$sw" | awk '{for(i=1;i<=NF;i++)if($i=="used")print $(i+2)}' | tr -d 'M')
  local sw_tot=$(print -r -- "$sw" | awk '{for(i=1;i<=NF;i++)if($i=="total")print $(i+2)}' | tr -d 'M')
  local freeg=$(( (free+spec)*pg/1073741824.0 )) totalg=$(( total/1073741824.0 ))
  local compg=$(( comp*pg/1073741824.0 ))
  # Pressure if real free RAM is under ~4% of total, or swap is nearly full.
  local flag=""
  (( freeg < totalg*0.04 || (sw_tot>0 && sw_used > sw_tot*0.9) )) && flag="  ⚠ UNDER PRESSURE (compress/swap thrash → slow)"
  printf 'mem: %.0fG total · %.1fG free · %.1fG compressed · swap %.1f/%.1fG%s\n' \
    $totalg $freeg $compg $((sw_used/1024.0)) $((sw_tot/1024.0)) "$flag"
}

# Show your top memory-consuming processes, each mapped to the tmux pane + app
# that owns it, plus its working dir. Leads with a system memory-pressure line
# (whether you're actually slow) and shows %CPU per process, because memory size
# alone is misleading: a heavy process that's also pegging CPU is a runaway (⚠),
# while a heavy idle one is just cheap-to-reclaim cache. %CPU here is ps's recent
# average — for a precise current reading on a suspect, use `proc-impact <pid>`.
# Optional args: row count (default 20) and a grep pattern on the command
# (e.g. `mem-owners 30 node`).
mem-owners() {
  emulate -L zsh
  local n=${1:-20} filter=${2:-.}
  _mem_pressure
  local panes=$(tmux list-panes -a -F '#{pane_pid} #{session_name} #{window_index}:#{window_name}' 2>/dev/null)
  printf '%8s  %5s  %-7s  %-7s  %-40s  %-16s  %s\n' MEM %CPU PID APP "TMUX PANE" COMMAND DIR
  ps -U "$USER" -o pid=,rss=,%cpu=,comm= \
    | grep -E "$filter" \
    | sort -k2 -rn | head -n "$n" \
    | while read -r pid rss cpu comm; do
        local app=$(_proc_app "$pid")
        local pane=$(_proc_pane "$pid" "$panes")
        # cwd only matters for tree/dev processes; skip lsof for GUI/system procs.
        local cwd=""
        [[ -n "$pane" || "$app" != "-" ]] && cwd=$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')
        # Flag the runaway shape: lots of RAM AND sustained CPU (both drains).
        local flag=""
        (( rss/1024 > 4000 && cpu > 50 )) && flag="  ⚠ runaway?"
        printf '%6dMB  %5.0f  %-7s  %-7s  %-40s  %-16s  %s%s\n' \
          "$((rss/1024))" "$cpu" "$pid" "$app" "${pane:-<no tmux pane>}" "${comm:t}" "${cwd:t}" "$flag"
      done
}

# Focused view: just the tsgo LSPs, sorted by memory. Wrapper over mem-owners.
tsgo-owners() { mem-owners 50 'native-preview.*lib/tsgo'; }

# Drill-down on one pid: is it a runaway worth killing, or legitimately busy?
# Codifies the diagnosis that found a tsgo burning 1.6 cores + 16GB for a day.
# Measures CPU two ways, because each lies on its own:
#   - "now": a precise delta over <window>s (default 4) — truth about this moment.
#   - "lifetime": total CPU vs uptime — flags slow churners ps's %CPU misses.
# A language server (or any event-driven proc) sitting well above ~0% when you
# are not actively driving it is the runaway tell. Usage: proc-impact <pid> [s].
proc-impact() {
  emulate -L zsh
  local pid=${1:?usage: proc-impact <pid> [window-secs]} w=${2:-4}
  ps -p "$pid" >/dev/null 2>&1 || { print -- "no such pid: $pid"; return 1; }
  local comm=$(ps -o comm= -p "$pid"); comm=${comm:t}
  local app=$(_proc_app "$pid") pane=$(_proc_pane "$pid")
  local rssg=$(( $(ps -o rss= -p "$pid" | tr -d ' ')/1048576.0 ))
  local c1=$(_to_secs "$(ps -o time= -p "$pid")")
  sleep "$w"
  local c2=$(_to_secs "$(ps -o time= -p "$pid")")
  local life=$(_to_secs "$(ps -o etime= -p "$pid")")
  local now=$(( (c2-c1)/w*100 )) avg=$(( life>0 ? c2/life*100 : 0 ))
  print -- "${comm} (pid ${pid})  —  owner: ${app}  ${pane:-<no tmux pane>}"
  printf '  memory:        %.1f GB\n' $rssg
  printf '  CPU now:       %.0f%% of one core   (measured over %ss)\n' $now $w
  printf '  CPU lifetime:  %.1f CPU-hours over %.1fh up  = %.0f%% avg of one core\n' \
    $((c2/3600.0)) $((life/3600.0)) $avg
  local verdict
  if   (( now > 80 && rssg > 4 )); then verdict="⚠ RUNAWAY — heavy CPU + memory. Safe to kill if its owner isn't actively using it (it respawns)."
  elif (( now > 80 ));            then verdict="busy now (CPU-bound). Killing interrupts real work in progress."
  elif (( now < 5 && rssg > 4 )); then verdict="idle but holding memory — cheap to reclaim."
  elif (( avg > 40 ));            then verdict="⚠ low right now but a long-run churner (high lifetime avg) — watch it."
  else                                 verdict="nominal."
  fi
  print -- "  verdict:       $verdict"
}

# --- spike recorder -----------------------------------------------------------
# tsgo runaways settle within a minute, so by the time you notice and attach,
# the evidence is gone. This captures a full trace the moment a tsgo crosses a
# threshold, so the "why" is recorded in the act. Driven by a launchd agent
# (every 60s) but also runnable by hand. Tunable via env:
#   TSGO_MEM_GB (8)  TSGO_CPU (200)  TSGO_COOLDOWN (900s)  TSGO_TRACE_DIR (~/tsgo-traces)

# Write one trace file for a hot pid: pressure + proc-impact + owner chain +
# open dirs (watch scope) + a CPU sample (where it's actually spending time).
_tsgo_snapshot() {
  emulate -L zsh
  zmodload zsh/datetime 2>/dev/null
  local pid=$1 dir=$2 gb=$3 cpuv=$4
  local out="$dir/tsgo-$pid-$(strftime '%Y%m%d-%H%M%S' $EPOCHSECONDS).txt"
  {
    printf '=== tsgo spike — %s ===\n' "$(strftime '%Y-%m-%d %H:%M:%S' $EPOCHSECONDS)"
    printf 'pid=%s  trigger: %.1fGB / %s%% CPU\n' "$pid" "$gb" "$cpuv"
    printf '\n--- system pressure ---\n';  _mem_pressure
    printf '\n--- proc-impact ---\n';       proc-impact "$pid" 3
    printf '\n--- owner chain ---\n'
    local cur=$pid
    while [ -n "$cur" ] && [ "$cur" != "1" ]; do
      ps -o pid=,ppid=,command= -p "$cur" 2>/dev/null | cut -c1-130
      cur=$(ps -o ppid= -p "$cur" 2>/dev/null | tr -d ' ')
    done
    printf '\n--- open dirs/files (top 25 — hints at watch scope) ---\n'
    lsof -p "$pid" 2>/dev/null | awk '$5=="DIR"||$5=="REG"{print $9}' | sort | uniq -c | sort -rn | head -25
    printf '\n--- CPU sample (3s — where the cores go) ---\n'
    sample "$pid" 3 2>/dev/null
  } > "$out" 2>&1
  print -- "[tsgo-watch] captured $out"
}

# One pass: snapshot every tsgo over threshold (respecting per-pid cooldown).
# This is what the launchd agent runs each tick; safe to run by hand too.
tsgo-watch-once() {
  emulate -L zsh
  zmodload zsh/datetime 2>/dev/null
  local dir=${TSGO_TRACE_DIR:-$HOME/tsgo-traces}
  local mem_gb=${TSGO_MEM_GB:-8} cpu=${TSGO_CPU:-200} cooldown=${TSGO_COOLDOWN:-900}
  mkdir -p "$dir"
  local now=$EPOCHSECONDS
  ps -axo pid=,rss=,%cpu=,command= | grep -E 'native-preview.*lib/tsgo' | grep -v grep \
  | while read -r pid rss cpuv rest; do
      local gb=$(( rss/1048576.0 ))
      (( gb >= mem_gb || cpuv >= cpu )) || continue          # below trigger
      local cf="$dir/.last-$pid"
      [[ -f "$cf" ]] && (( now - $(<"$cf") < cooldown )) && continue   # cooling down
      print -r -- "$now" > "$cf"
      _tsgo_snapshot "$pid" "$dir" "$gb" "$cpuv"
    done
}

# Foreground watcher loop (for ad-hoc capture without launchd). Ctrl-C to stop.
tsgo-watch() {
  emulate -L zsh
  local interval=${TSGO_INTERVAL:-60}
  print -- "tsgo-watch: snapshot tsgo over ${TSGO_MEM_GB:-8}GB or ${TSGO_CPU:-200}% CPU"
  print -- "  -> ${TSGO_TRACE_DIR:-$HOME/tsgo-traces}  every ${interval}s. Ctrl-C to stop."
  while true; do tsgo-watch-once; sleep "$interval"; done
}

# Idle eviction: reclaim memory from tsgo that have sat idle (≈0% CPU) for >= N
# minutes, so inactive Claude/nvim sessions stop hogging ~18GB each. This is the
# local stand-in for an idle-TTL that lspMcp/tsgo don't have. A reaped idle tsgo
# stays gone (an inactive session makes no LSP requests) and respawns cold only
# when you return and actually do TS work. Idleness is tracked across runs via
# marker files in TSGO_TRACE_DIR, so a momentary pause between keystrokes can't
# trigger a kill — it must stay idle for the whole window.
#   tsgo-reap-idle [idle_minutes]   (default 20; or $TSGO_IDLE_MIN)
# Tunables: TSGO_IDLE_CPU (%, default 3)  TSGO_IDLE_MIN_GB (default 2).
tsgo-reap-idle() {
  emulate -L zsh
  zmodload zsh/datetime 2>/dev/null
  local mins=${1:-${TSGO_IDLE_MIN:-20}}
  local cpu_idle=${TSGO_IDLE_CPU:-3} min_gb=${TSGO_IDLE_MIN_GB:-2}
  local dir=${TSGO_TRACE_DIR:-$HOME/tsgo-traces}
  mkdir -p "$dir"
  local now=$EPOCHSECONDS window=$(( mins*60 ))
  local -A live
  local rows=$(ps -axo pid=,rss=,%cpu=,command= | grep -E 'native-preview.*lib/tsgo' | grep -v grep)
  local line pid rss cpuv rest gb marker since
  while IFS= read -r line; do
    [[ -z $line ]] && continue
    read -r pid rss cpuv rest <<< "$line"
    live[$pid]=1
    marker="$dir/.idle-$pid"
    gb=$(( rss/1048576.0 ))
    # Active, or too small to bother: reset its idle clock and move on.
    if (( cpuv > cpu_idle || gb < min_gb )); then
      rm -f "$marker"
      continue
    fi
    # Idle: stamp first-seen-idle, or reap once it's been idle the full window.
    if [[ ! -f "$marker" ]]; then
      print -r -- "$now" > "$marker"
      continue
    fi
    since=$(<"$marker")
    if (( now - since >= window )); then
      kill -TERM "$pid" 2>/dev/null
      rm -f "$marker"
      print -- "[tsgo-reap-idle] reaped $pid — idle $(( (now-since)/60 ))m, holding ${gb%.*}GB (respawns on next request)"
    fi
  done <<< "$rows"
  # Drop markers for pids that have since exited.
  local f p
  for f in "$dir"/.idle-*(N); do
    p=${f:t}; p=${p#.idle-}
    [[ -n ${live[$p]} ]] || rm -f "$f"
  done
}

# Reap stale tsgo LSPs. No args: show the table + usage. With pids: SIGTERM them.
# --over <GB>: SIGTERM every tsgo above that size (after a y/N confirm).
# The owning editor/agent respawns the LSP on its next request (warm index lost).
tsgo-reap() {
  emulate -L zsh
  if [[ $# -eq 0 ]]; then
    tsgo-owners
    print -- "\nUsage: tsgo-reap <pid…>       kill specific tsgo LSPs"
    print -- "       tsgo-reap --over <GB>  kill every tsgo above <GB>"
    return 0
  fi

  local -a targets
  if [[ $1 == --over ]]; then
    local gb=${2:?need a GB threshold} limit
    limit=$(( gb * 1024 * 1024 ))   # KB
    targets=(${(f)"$(ps -axo pid=,rss=,command= | grep -E 'native-preview.*lib/tsgo' | grep -v grep | awk -v l=$limit '$2>l {print $1}')"})
    (( ${#targets} )) || { print -- "No tsgo over ${gb}GB."; return 0; }
    print -- "Will SIGTERM these tsgo LSPs (>${gb}GB):"
    ps -o pid=,rss= -p ${(j: :)targets} 2>/dev/null | awk '{printf "  %-7s %dMB\n",$1,$2/1024}'
    print -n -- "Proceed? [y/N] "
    read -q || { print; return 1; }
    print
  else
    targets=($@)
  fi

  kill -TERM ${(j: :)targets} 2>/dev/null \
    && print -- "Sent SIGTERM to: ${(j:, :)targets}  (LSP respawns on next request)"
}

dark-ui() {
  echo "dark" > ~/.config/theme
  : > ~/.config/ghostty/theme-override
  osascript -e 'tell app "System Events" to tell appearance preferences to set dark mode to true'
  _notify_nvim_theme dark
}

light-ui() {
  echo "light" > ~/.config/theme
  : > ~/.config/ghostty/theme-override
  osascript -e 'tell app "System Events" to tell appearance preferences to set dark mode to false'
  _notify_nvim_theme light
}

dark-term() {
  echo "dark" > ~/.config/theme
  echo "theme = tiki-love-dark" > ~/.config/ghostty/theme-override
  _reload_ghostty
  source ~/.p10k-dark.zsh
  _notify_nvim_theme dark
}

light-term() {
  # Switch only Neovim to light; leave the terminal (Ghostty + prompt) on tiki.
  _notify_nvim_theme light
}

_reload_ghostty() {
  osascript -e 'tell application "System Events" to keystroke "," using {command down, shift down}'
}

_notify_nvim_theme() {
  local mode="$1"
  # Neovim keeps its own theme state (separate from the terminal's ~/.config/theme)
  # so new nvim windows match, even when only the editor was switched.
  echo "$mode" > ~/.config/theme-nvim

  # Find every running nvim's RPC socket and tell it to re-apply the theme.
  #
  # nvim's default socket lives at <temp-root>/nvim.<user>/<random>/nvim.<pid>.0.
  # The <temp-root> depends on how nvim was launched: a login/tmux shell sees a
  # different $TMPDIR than this function might, and macOS uses a per-user
  # /var/folders/... path rather than /tmp. So instead of guessing one root,
  # search all the plausible roots and ping whatever sockets we find.
  local user="$(whoami)"
  local -a roots
  roots=(
    "${TMPDIR:-/tmp}"
    "${XDG_RUNTIME_DIR}"
    /tmp
    "$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null)"   # macOS per-user /var/folders root
  )

  local -a socks
  local root
  for root in "${roots[@]}"; do
    [ -n "$root" ] && [ -d "$root" ] || continue
    # nvim.<user> dirs may sit a level or two under the temp root; the socket
    # itself is one level below that. -L follows the symlinked dirs nvim uses.
    socks+=(${(f)"$(find -L "$root" -maxdepth 4 -type s -path "*nvim.${user}*" 2>/dev/null)"})
  done

  # Dedupe (roots can overlap, e.g. $TMPDIR == /tmp) and ping each live socket.
  local sock
  for sock in ${(u)socks}; do
    [ -S "$sock" ] || continue
    nvim --server "$sock" --remote-send "<Cmd>lua require('lib.theme').apply('$mode')<CR>" </dev/null 2>/dev/null
  done
}
